POSTGRES_DB=apprentice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local-only demo key. Set a unique, strong value outside local development.
ADMIN_API_KEY=local-admin-change-me
DEMO_DATA=true

# Claude performs vision, interviews, maps and tutoring.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ELEVENLABS_API_KEY=
# The Agent speaks Claude's exact text through real conversations; enable First message and Language overrides.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_AGENT_ID=
